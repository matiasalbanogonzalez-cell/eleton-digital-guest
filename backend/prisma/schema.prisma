generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                 String        @id @default(uuid())
  nombre             String
  apellido           String
  email              String        @unique
  passwordHash       String
  habitacion         String?
  telefono           String?
  rol                Rol           @default(HUESPED)
  creadoEn           DateTime      @default(now())
  actividadesCreadas Actividad[]   @relation("ActividadesCreadasPor")
  inscripciones      Inscripcion[]

  @@map("usuarios")
}

model Instructor {
  id          String      @id @default(uuid())
  nombre      String
  apellido    String
  telefono    String?
  email       String?
  actividades Actividad[]

  @@map("instructores")
}

model Actividad {
  id            String          @id @default(uuid())
  nombre        String
  descripcion   String
  categoria     Categoria
  imagenUrl     String?
  fecha         DateTime
  horaInicio    String
  horaFin       String
  lugar         String
  edadMinima    Int
  edadMaxima    Int
  cupoMaximo    Int
  estado        EstadoActividad @default(ABIERTA)
  creadoEn      DateTime        @default(now())
  instructorId  String?
  creadaPorId   String?
  creadaPor     Usuario?        @relation("ActividadesCreadasPor", fields: [creadaPorId], references: [id])
  instructor    Instructor?     @relation(fields: [instructorId], references: [id])
  inscripciones Inscripcion[]

  @@unique([fecha, horaInicio, categoria, nombre])
  @@map("actividades")
}

model Inscripcion {
  id               String            @id @default(uuid())
  usuarioId        String
  actividadId      String
  fechaInscripcion DateTime          @default(now())
  estado           EstadoInscripcion @default(CONFIRMADA)
  asistio          Boolean           @default(false)
  actividad        Actividad         @relation(fields: [actividadId], references: [id])
  usuario          Usuario           @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, actividadId])
  @@map("inscripciones")
}

enum Rol {
  HUESPED
  RECREADOR
  ADMIN
}

enum Categoria {
  KIDS
  ADOLESCENTES
  ADULTOS
}

enum EstadoActividad {
  ABIERTA
  CUPO_LLENO
  CANCELADA
  FINALIZADA
}

enum EstadoInscripcion {
  CONFIRMADA
  LISTA_ESPERA
  CANCELADA
}
