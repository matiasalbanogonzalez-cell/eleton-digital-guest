// Recreación Eleton — esquema de base de datos
// Basado en el documento de requerimientos: Usuario, Actividad, Inscripción, Instructor

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  HUESPED
  RECREADOR
  ADMIN_RESTO
  ADMIN_SPA
  ADMIN_TEATRO
  ADMIN
}

enum Categoria {
  KIDS
  ADOLESCENTES
  ADULTOS
}

enum EstadoActividad {
  ABIERTA
  CUPO_LLENO
  CANCELADA
  FINALIZADA
}

enum EstadoInscripcion {
  CONFIRMADA
  LISTA_ESPERA
  CANCELADA
}

model Usuario {
  id            String    @id @default(uuid())
  nombre        String
  apellido      String
  email         String    @unique
  passwordHash  String
  habitacion    String?
  telefono      String?
  rol           Rol       @default(HUESPED)
  creadoEn      DateTime  @default(now())

  actividadesCreadas Actividad[]    @relation("ActividadesCreadasPor")
  inscripciones      Inscripcion[]
  reservasResto      ReservaResto[] @relation("ReservasResto")
  reservasSpa        ReservaSpa[]   @relation("ReservasSpa")
  reservasTeatro     ReservaTeatro[] @relation("ReservasTeatro")
  avisosCreados      Aviso[]        @relation("AvisosCreadosPor")
  tokensRevocados    TokenRevocado[]

  @@map("usuarios")
}

model TokenRevocado {
  jti       String   @id
  usuarioId String
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiraEn])
  @@map("tokens_revocados")
}

model Instructor {
  id         String      @id @default(uuid())
  nombre     String
  apellido   String
  telefono   String?
  email      String?
  actividades Actividad[]

  @@map("instructores")
}

model Actividad {
  id            String          @id @default(uuid())
  nombre        String
  descripcion   String
  categoria     Categoria
  imagenUrl     String?
  fecha         DateTime
  horaInicio    String          // "15:00"
  horaFin       String          // "16:00"
  lugar         String
  edadMinima    Int
  edadMaxima    Int
  cupoMaximo    Int
  estado        EstadoActividad @default(ABIERTA)
  creadoEn      DateTime        @default(now())

  instructorId  String?
  instructor    Instructor?     @relation(fields: [instructorId], references: [id])

  creadaPorId   String?
  creadaPor     Usuario?        @relation("ActividadesCreadasPor", fields: [creadaPorId], references: [id])

  inscripciones Inscripcion[]

  @@unique([fecha, horaInicio, categoria, nombre])
  @@map("actividades")
}

model Inscripcion {
  id               String            @id @default(uuid())
  usuarioId        String
  usuario          Usuario           @relation(fields: [usuarioId], references: [id])
  actividadId      String
  actividad        Actividad         @relation(fields: [actividadId], references: [id])
  fechaInscripcion DateTime          @default(now())
  estado           EstadoInscripcion @default(CONFIRMADA)
  asistio          Boolean           @default(false)

  // Regla de negocio: un huésped no puede inscribirse dos veces a la misma actividad
  @@unique([usuarioId, actividadId])
  @@map("inscripciones")
}

// ============================================================
// Módulo Restó — reservas de mesa, salones y disponibilidad.
// Independiente de Recreación: no toca Actividad/Inscripcion.
// ============================================================

enum ServicioRestoNombre {
  DESAYUNO
  ALMUERZO
  MERIENDA
  CENA
}

enum EstadoReservaResto {
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model SalonResto {
  id                String   @id @default(uuid())
  nombre            String   @unique
  mesas             Int
  capacidadPersonas Int
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  disponibilidades DisponibilidadSalonResto[]
  reservas         ReservaResto[]

  @@map("salones_resto")
}

model ServicioResto {
  id     String              @id @default(uuid())
  nombre ServicioRestoNombre @unique
  activo Boolean             @default(true)

  disponibilidades DisponibilidadSalonResto[]
  reservas         ReservaResto[]
  horarios         HorarioResto[]

  @@map("servicios_resto")
}

// Horarios puntuales dentro de un servicio (ej: Cena a las 21:00 y a las 22:00).
// Opcional: un servicio sin horarios cargados se reserva sin elegir hora puntual.
model HorarioResto {
  id         String        @id @default(uuid())
  servicioId String
  servicio   ServicioResto @relation(fields: [servicioId], references: [id])
  hora       String
  activo     Boolean       @default(true)

  reservas ReservaResto[]

  @@unique([servicioId, hora])
  @@map("horarios_resto")
}

// Habilita/deshabilita un salón para un servicio en una fecha puntual.
// La configura exclusivamente el administrador; el huésped nunca la ve.
model DisponibilidadSalonResto {
  id         String        @id @default(uuid())
  salonId    String
  salon      SalonResto    @relation(fields: [salonId], references: [id])
  servicioId String
  servicio   ServicioResto @relation(fields: [servicioId], references: [id])
  fecha      DateTime
  habilitado Boolean       @default(true)

  @@unique([salonId, servicioId, fecha])
  @@map("disponibilidad_salon_resto")
}

model ReservaResto {
  id         String             @id @default(uuid())
  nombre     String
  habitacion String
  personas   Int
  fecha      DateTime
  servicioId String
  servicio   ServicioResto      @relation(fields: [servicioId], references: [id])
  horarioId  String?
  horario    HorarioResto?      @relation(fields: [horarioId], references: [id])
  salonId    String
  salon      SalonResto         @relation(fields: [salonId], references: [id])
  estado     EstadoReservaResto @default(CONFIRMADA)
  usuarioId  String?
  usuario    Usuario?           @relation("ReservasResto", fields: [usuarioId], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("reservas_resto")
}

// ============================================================
// Avisos generales y zonas del hotel.
// ============================================================

enum PrioridadAviso {
  BAJA
  MEDIA
  ALTA
}

// Agrupa habitaciones por ubicación física, para poder filtrar avisos por
// zona. Lista explícita (no rango numérico) porque hay códigos no numéricos
// (SB, SA en Subsuelo).
model ZonaHotel {
  id           String   @id @default(uuid())
  nombre       String   @unique
  habitaciones String[]

  avisos Aviso[]

  @@map("zonas_hotel")
}

model Aviso {
  id              String         @id @default(uuid())
  titulo          String
  mensaje         String
  fechaInicio     DateTime
  fechaFin        DateTime
  activo          Boolean        @default(true)
  prioridad       PrioridadAviso @default(MEDIA)
  seccionAfectada String?
  zonas           ZonaHotel[]
  creadoPorId     String
  creadoPor       Usuario        @relation("AvisosCreadosPor", fields: [creadoPorId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("avisos")
}

// ============================================================
// Módulo Spa — Circuito Hídrico: temporadas, horarios, turnos,
// restricciones para niños y reservas. Independiente de Restó/Recreación.
// ============================================================

model TemporadaSpa {
  id           String   @id @default(uuid())
  nombre       String
  fechaInicio  DateTime
  fechaFin     DateTime
  horaApertura String
  horaCierre   String
  activo       Boolean  @default(true)

  @@map("temporadas_spa")
}

// Horario "normal" fuera de temporada alta.
model HorarioBaseSpa {
  id           String @id @default(uuid())
  diaSemana    Int    // 0=domingo … 6=sábado
  horaApertura String
  horaCierre   String

  @@unique([diaSemana])
  @@map("horario_base_spa")
}

// Ventanas horarias en las que se permite ingresar con niños.
model RestriccionNinosSpa {
  id         String  @id @default(uuid())
  horaInicio String
  horaFin    String
  activo     Boolean @default(true)

  @@map("restriccion_ninos_spa")
}

model TurnoSpa {
  id              String   @id @default(uuid())
  fecha           DateTime
  horaInicio      String
  horaFin         String
  capacidadMaxima Int      @default(25)

  reservas ReservaSpa[]

  @@unique([fecha, horaInicio])
  @@map("turnos_spa")
}

enum EstadoReservaSpa {
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model ReservaSpa {
  id              String           @id @default(uuid())
  nombre          String
  habitacion      String
  turnoId         String
  turno           TurnoSpa         @relation(fields: [turnoId], references: [id])
  personasAdultos Int              @default(1)
  personasNinos   Int              @default(0)
  estado          EstadoReservaSpa @default(CONFIRMADA)
  usuarioId       String?
  usuario         Usuario?         @relation("ReservasSpa", fields: [usuarioId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("reservas_spa")
}

// ============================================================
// Módulo Teatro — funciones, formatos de sala y reservas.
// Independiente de Restó/Recreación/Spa.
// ============================================================

model FormatoSalaTeatro {
  id     String  @id @default(uuid())
  nombre String  @unique
  aforo  Int
  activo Boolean @default(true)

  funciones FuncionTeatro[]

  @@map("formatos_sala_teatro")
}

enum EstadoFuncion {
  PROGRAMADA
  CANCELADA
  FINALIZADA
}

model FuncionTeatro {
  id            String            @id @default(uuid())
  espectaculo   String
  fecha         DateTime
  hora          String
  formatoSalaId String
  formatoSala   FormatoSalaTeatro @relation(fields: [formatoSalaId], references: [id])
  estado        EstadoFuncion     @default(PROGRAMADA)
  createdAt     DateTime          @default(now())

  reservas ReservaTeatro[]

  @@unique([fecha, hora])
  @@map("funciones_teatro")
}

enum EstadoReservaTeatro {
  CONFIRMADA
  CANCELADA
}

model ReservaTeatro {
  id         String              @id @default(uuid())
  nombre     String
  habitacion String
  funcionId  String
  funcion    FuncionTeatro       @relation(fields: [funcionId], references: [id])
  personas   Int
  estado     EstadoReservaTeatro @default(CONFIRMADA)
  usuarioId  String?
  usuario    Usuario?            @relation("ReservasTeatro", fields: [usuarioId], references: [id])
  createdAt  DateTime            @default(now())

  @@map("reservas_teatro")
}
